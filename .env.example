# SentryyIQ API (used by frontend via VITE_* — public)
VITE_API_BASE_URL=http://localhost:8000

# SentryyIQ login (JWT). Generate a long random string for JWT_SECRET.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Salveris (server-side only — never prefix with VITE_)
# Use a different port than SentryyIQ (8000). Example: Salveris on 8001.
SALVERIS_BASE_URL=http://localhost:8001
# HTTP timeout for Salveris answer/search (seconds).
# Local Ollama forensic asks often take 100–160s; keep well above that or
# /copilot/ask returns 502 "Salveris unavailable" while Salveris is still generating.
SALVERIS_TIMEOUT_SECONDS=300
SALVERIS_CALLING_PLATFORM_ID=
SALVERIS_SERVICE_PRINCIPAL_ID=
SALVERIS_CLIENT_SECRET=
# Acting principals are stored on user_master.external_reference (seed with
# python -m backend.scripts.set_user_credentials --seed-alice-bob).
# Optional env vars below are used only when inserting a missing user.
# SALVERIS_DEFAULT_ACTING_PRINCIPAL_ID=
# SALVERIS_BOB_ACTING_PRINCIPAL_ID=
# SALVERIS_RITA_ACTING_PRINCIPAL_ID=
